# The one file to edit. Ansible, OpenTofu and the policies of the hashi stack read it.
# Secrets are not here: they are in vault.yml, encrypted.

# Name of the stack, also the Consul and Nomad datacenter.
name: {{ .project }}

server:
  # Public address of the server, as the provider gave it.
  address: {{ yaml .server_address }}
  # The user you log in with today; the bootstrap step replaces it with ops_user.
  bootstrap_user: {{ yaml .bootstrap_user }}
  # The one user that may log in afterwards, with your SSH key. Chosen once: a set up server
  # refuses another name.
  ops_user: {{ yaml .ops_user }}
  # A user of that name that damstack did not create is left alone, unless this says to take
  # it over: then your key is added to it, and its other keys stay.
  adopt_user: false
  # Network interface of the server to the internet.
  public_interface: {{ yaml .public_interface }}
  # Ports open to the internet: 80 and 443 for Traefik{{ if .mail }}, 25, 465, 587 and 993 for mail{{ end }}.
  public_ports: [80, 443{{ if .mail }}, 25, 465, 587, 993{{ end }}]

# Private network over WireGuard. The server takes the first address of this /24,
# each client the next ones, in order.
network:
  cidr: 10.77.0.0/24
  clients: {{ yaml .wireguard_clients }}

# Admin pages: consul., nomad. and vault.<infra_domain>, through the private network only.
infra_domain: {{ yaml .infra_domain }}
# Contact of the Let's Encrypt account of Traefik.
acme_email: {{ yaml .acme_email }}

# Where DNS records go. With cloudflare, every domain in zones gets its records through
# the Cloudflare API; records of other domains are printed by damstack output manual_records,
# to be created by hand.
dns:
  provider: cloudflare
  zones: {{ yaml .dns_zones }}

# Backups, made with restic: on the server every night, and on your laptop when damstack
# pulls them. restic compresses, deduplicates and encrypts them with vault_backup_password.
backup:
  schedule: "03:00"
  compression: auto
  server:
    path: /var/backups/restic
    keep: {daily: 7, weekly: 4, monthly: 6}
  laptop:
    path: ~/Backups/{{ .project }}
    keep: {daily: 30, weekly: 12, monthly: 24}
    pull_every: 1h

# Apps on the platform, each a module of its own. Deleting the block of an app removes the
# app; the policies refuse the plan while it would destroy the app's data.
{{- if .mail }}
apps:
  mail:
    hostname: {{ yaml .mail_hostname }}
    domains: {{ yaml .mail_domains }}
    acme_email: {{ yaml .acme_email }}
{{- else }}
apps: {}
{{- end }}
